[Unit]
Description=Heybox (xiaoheihe) private REST bridge for the unified mouth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/root
WorkingDirectory=/root
ExecStart=/root/.local/bin/xiaoheihe-cli api --port 8010
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
