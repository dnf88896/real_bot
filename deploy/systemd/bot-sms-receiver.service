[Unit]
Description=Receive-only bot SMS and phone heartbeat
After=network-online.target
Wants=network-online.target
[Service]
User=qq-social
Group=qq-social
WorkingDirectory=/opt/bot-inbox
ExecStart=/usr/bin/python3 /opt/bot-inbox/sms_ingress.py
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/bot-inbox
[Install]
WantedBy=multi-user.target
